# Copy to `.env` (which is gitignored) and adjust. Never commit real secrets.

POSTGRES_USER=jobtrail
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobtrail

# Used when the API runs outside Docker (VS Code debugger, plain uvicorn).
# Keep the password in sync with POSTGRES_PASSWORD above.
DATABASE_URL=postgresql+psycopg://jobtrail:change-me@localhost:5432/jobtrail
CORS_ORIGINS=http://localhost:3000

# --- AI extraction (optional): paste a job posting and fill in the form ---
# Leave LLM_PROVIDER=none to keep it off.
#
# Option A, free and private: Ollama on your own computer (https://ollama.com).
#   Install it, run `ollama pull <model>`, then set:
#     LLM_PROVIDER=ollama
#     LLM_MODEL=<the model you pulled, e.g. llama3.1:8b>
#
# Option B: OpenAI (pay per use; the posting text is sent to OpenAI).
#     LLM_PROVIDER=openai
#     LLM_MODEL=<a model name available on your OpenAI account>
#     LLM_API_KEY=<your key>
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
# Only needed if the API runs inside Docker and Ollama runs on your PC:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
